# Copia este archivo a .env y completa los valores con tus credenciales.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Opcional: GPU NVIDIA para Ollama. Descomentá ambas lineas para que un
# `docker compose up -d` simple incluya docker-compose.gpu.yml.
# COMPOSE_PATH_SEPARATOR=:
# COMPOSE_FILE=docker-compose.yml:docker-compose.gpu.yml
