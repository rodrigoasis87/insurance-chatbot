# Copia este archivo a .env y completa los valores con tus credenciales.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# --- LLM (Issue #9). Default: Ollama + qwen3:4b-instruct (ADR-001, sin thinking).
# Extra post-MVP: ollama | openai | anthropic. Se cambia SOLO LLM_PROVIDER.
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_CHAT_MODEL=qwen3:4b-instruct
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
ANTHROPIC_CHAT_MODEL=claude-haiku-4-5-20251001

# --- Embeddings (siempre locales, multilingue). Cambiarlo obliga a reindexar con --recreate.
EMBEDDING_MODEL=qwen3-embedding:0.6b

# --- Qdrant (docker compose)
QDRANT_URL=http://127.0.0.1:6333
QDRANT_COLLECTION=polizas