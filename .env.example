# Copia este archivo a .env y completa los valores con tus credenciales.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# --- LLM (Issue #9 / ADR-006). Default: Ollama + qwen3:4b-instruct (ADR-001, sin thinking).
# Proveedores: ollama | openai | anthropic | google. Se cambia SOLO LLM_PROVIDER.
# cloud (openai/anthropic/google) = opt-in DE DEMO (ADR-006): la consulta sale del
# sistema; embeddings y corpus sigen siendo locales.
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_CHAT_MODEL=qwen3:4b-instruct
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
ANTHROPIC_CHAT_MODEL=claude-haiku-4-5-20251001
GOOGLE_API_KEY=
GOOGLE_CHAT_MODEL=gemini-3.5-flash-lite

# --- Embeddings (siempre locales, multilingue). Cambiarlo obliga a reindexar con --recreate.
EMBEDDING_MODEL=qwen3-embedding:0.6b

# --- Auth del API (Issue #44). Header X-API-Key en /chat, /chat/stream y
# /policy-recombine; /health queda publico (smoke test). La UI y
# scripts/demo_recorrido.py mandan esta misma key.
# Vacio = modo dev SIN auth (el API lo avisa con un warning al arrancar).
# Genera una con: python -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEY=

# --- Login de la UI Chainlit. Sin CHAINLIT_AUTH_SECRET la UI no arranca
# (firma la sesion del login). Generalo con: uv run chainlit create-secret
# Cambiarlo cierra las sesiones abiertas. Usuario/contraseña vacios = admin/admin.
CHAINLIT_AUTH_SECRET=
UI_USERNAME=admin
UI_PASSWORD=admin

# --- Qdrant (docker compose)
QDRANT_URL=http://127.0.0.1:6333
QDRANT_COLLECTION=polizas

# --- Retrieval (Issue #42). dense = solo embeddings (default) | hybrid = denso + BM25
# fusionados con RRF (indice BM25 en memoria desde data/processed/chunks.jsonl).
# Cada modo tiene su hard gate (escalas distintas, ver docs/umbral_score.md):
# UMBRAL_SCORE = coseno (denso; en hybrid es ademas el piso semantico antes de fusionar)
# UMBRAL_SCORE_HYBRID = score RRF normalizado a [0, 1] (solo hybrid)
RETRIEVAL_MODE=dense
UMBRAL_SCORE=0.60
UMBRAL_SCORE_HYBRID=0.40

# --- Observabilidad (Langfuse, Issue #48) — OPCIONAL.
# Sin esto el modulo app.observability queda en modo noop: no se importa el SDK
# y no se abre ninguna conexion (el hot path no cambia).
#
# Self-host (compose overlay):
#   docker compose -f docker-compose.yml -f docker-compose.observability.yml up -d
#   UI en http://localhost:3000.
#
# El primer usuario y las keys se pueden crear de dos formas:
#   a) desde la UI (Settings > API Keys) y copiarlas aca abajo, o
#   b) bootstrap automatico: exportar las LANGFUSE_INIT_* (ver el overlay),
#      que crean org/proyecto/usuario/keys en el primer arranque. OJO:
#      LANGFUSE_INIT_ORG_ID es obligatorio; sin el, las demas se ignoran.
#
# Cuando el API corre en Docker con el overlay, LANGFUSE_BASE_URL debe ser el
# hostname interno: http://langfuse-web:3000 (el overlay ya lo define asi).
#
# Cloud: LANGFUSE_BASE_URL=https://cloud.langfuse.com y sus keys.
LANGFUSE_ENABLED=false
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=http://127.0.0.1:3000
LANGFUSE_ENVIRONMENT=local
