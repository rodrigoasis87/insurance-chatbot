# Copia este archivo a .env y completa los valores con tus credenciales.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# --- LLM (Issue #9 / ADR-006). Default: Ollama + qwen3:4b-instruct (ADR-001, sin thinking).
# Proveedores: ollama | openai | anthropic | google. Se cambia SOLO LLM_PROVIDER.
# cloud (openai/anthropic/google) = opt-in DE DEMO (ADR-006): la consulta sale del
# sistema; embeddings y corpus sigen siendo locales.
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_CHAT_MODEL=qwen3:4b-instruct
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
ANTHROPIC_CHAT_MODEL=claude-haiku-4-5-20251001
GOOGLE_API_KEY=
GOOGLE_CHAT_MODEL=gemini-3.5-flash-lite

# --- Embeddings (siempre locales, multilingue). Cambiarlo obliga a reindexar con --recreate.
EMBEDDING_MODEL=qwen3-embedding:0.6b

# --- Qdrant (docker compose)
QDRANT_URL=http://127.0.0.1:6333
QDRANT_COLLECTION=polizas

# --- Observabilidad (Langfuse, Issue #48) — OPCIONAL.
# Sin esto el modulo app.observability queda en modo noop: no se importa el SDK
# y no se abre ninguna conexion (el hot path no cambia).
#
# Self-host (compose overlay):
#   docker compose -f docker-compose.yml -f docker-compose.observability.yml up -d
#   UI en http://localhost:3000 (el primer usuario se crea desde la UI).
# Las keys se copian de la UI (Settings > API Keys) aca abajo.
#
# Cloud: LANGFUSE_BASE_URL=https://cloud.langfuse.com y sus keys.
LANGFUSE_ENABLED=false
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=http://127.0.0.1:3000
LANGFUSE_ENVIRONMENT=local
