# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv

# Credenciales locales
.env

# Datos descargados (PDFs, etc.)
!/data/
/data/*
!/data/evaluation/
/data/evaluation/*
!/data/evaluation/*.jsonl
/data/evaluation/results/

# Config autogenerada de Chainlit (UI #18): se versiona config.toml y las
# traducciones editadas (login con "Usuario" en vez de "Correo electrónico")
.chainlit/translations/*
!.chainlit/translations/es.json
!.chainlit/translations/en-US.json

# Locks temporales de LibreOffice (nunca commitear)
.~lock.*#
